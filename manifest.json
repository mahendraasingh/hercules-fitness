{
  "manifest_version": 3,
  "name": "GitHub Contribution Graph – Halloween Orange Theme",
  "version": "1.0.0",
  "description": "Recreates GitHub's iconic Halloween-themed contribution graph with an authentic 5-level orange palette.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Halloween Contribution Theme",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
